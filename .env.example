# ==============================================================================
# Nuomu Soul Configuration Template (支持国内免梯 / 任意中转站 / 本地离线)
# ==============================================================================
# 最省心方式（新手强烈推荐）：直接运行 `npm run setup`
# 交互式输入中转站网址和 API Key，自动识别协议、补全路径、拉取模型列表并测试连通！
#
# 注意：所有纯核心模块、`npm run demo`、`npm test` 均无需任何 API Key。

# Data directory for diaries, milestones, soul ledger & usage logs (cross-platform)
NUOMU_DATA_DIR=./data

# ---- 方式 1（最推荐 · 零显卡纯云端全模型）：Claude / GPT / Gemini / Grok / DeepSeek / 任意中转站 ----
# 普通笔记本零显卡流畅运行！支持任意 URL 粘贴格式，引擎自动补全路径与识别协议：
#   - 任意中转站:       https://your-relay.com  或  https://your-relay.com/v1
#   - Claude (官方):    https://api.anthropic.com                (protocol=anthropic, model=claude-sonnet-4-5)
#   - GPT (OpenAI):     https://api.openai.com/v1                (protocol=openai,    model=gpt-4o)
#   - Gemini (官方):    https://generativelanguage.googleapis.com (protocol=gemini,   model=gemini-2.5-flash)
#   - Grok (xAI):       https://api.x.ai/v1                      (protocol=openai,    model=grok-3)
#   - DeepSeek (免梯):  https://api.deepseek.com                 (protocol=openai,    model=deepseek-chat)
#   - OpenRouter:       https://openrouter.ai/api/v1             (protocol=openai,    model=anthropic/claude-sonnet-4)
#   - 国内大厂直连:     https://api.siliconflow.cn/v1  |  https://dashscope.aliyuncs.com/compatible-mode/v1
#                       https://api.moonshot.cn/v1     |  https://open.bigmodel.cn/api/paas/v4
#                       https://ark.cn-beijing.volces.com/api/v3
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# auto | openai | anthropic | gemini | ollama
LLM_PROTOCOL=auto

# 也自动兼容市面上常见环境变量名（如果你本机配过，可直接复用）：
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=

# ---- 方式 2：完全离线免费的本地 Ollama（零网络、零费用）----
OLLAMA_BASE_URL=http://127.0.0.1:11434
NUOMU_LOCAL_MODEL=qwen2.5:7b-instruct

# ---- 本地 Web Studio 与原生 OneBot v11 桥接（完全自主、零第三方框架依赖）----
NUOMU_WEB_PORT=3460
# ONEBOT_LISTEN_PORT=3461
# ONEBOT_API_URL=http://127.0.0.1:3000
# ONEBOT_OWNER_ID=
# ONEBOT_ACCESS_TOKEN=
# ONEBOT_WEBHOOK_SECRET=

# ---- 方式 3（高级可选）：本地多模型 Gemini 4 网关 (127.0.0.1:3478) ----
# NUOMU_VERTEX_ENDPOINT_MODE=aistudio
# GEMINI_API_KEY=your-google-ai-studio-api-key
# NUOMU_VERTEX_PORT=3478
# Optional outbound HTTP proxy (leave unset for direct connection)
# NUOMU_VERTEX_PROXY=http://127.0.0.1:7897
