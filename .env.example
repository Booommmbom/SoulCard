# Nuomu Soul Configuration Template
# Copy to `.env` and fill only the providers you want to use.
# All pure core modules & `npm run demo` / `npm test` work with ZERO keys.

# Data directory for diaries, milestones, soul ledger & usage logs (cross-platform)
NUOMU_DATA_DIR=./data

# ---- Option A: Google AI Studio (Gemini 4 Neon / Hydrogen / Carbon / Argon) ----
NUOMU_VERTEX_ENDPOINT_MODE=aistudio
GEMINI_API_KEY=your-google-ai-studio-api-key

# ---- Option B: Google Cloud Vertex AI via ADC (for orgs that disable static API keys) ----
# Run: gcloud auth application-default login
# NUOMU_VERTEX_ENDPOINT_MODE=vertex
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global

# ---- Option C: DeepSeek API (for benchmark / low-cost daily chat) ----
DEEPSEEK_API_KEY=your-deepseek-api-key

# ---- Option D: Free Local Ollama (zero cloud cost for compaction, reflection & offline fallback) ----
OLLAMA_BASE_URL=http://127.0.0.1:11434
NUOMU_LOCAL_MODEL=qwen2.5:7b-instruct

# ---- Local Multi-Model Gateway ----
NUOMU_VERTEX_PORT=3478
# Optional outbound HTTP proxy (leave unset for direct connection)
# NUOMU_VERTEX_PROXY=http://127.0.0.1:7897
